VITE_API_BASE_URL=http://localhost:8000/api/v1

# Firebase Authentication — see FIREBASE_SETUP.md in the backend repo for
# how to get these from the Firebase console (Project settings -> General
# -> Your apps). Empty here: the app degrades gracefully with a console
# warning, but sign-in won't work until these are filled in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Contact shown in the Industry/Pharma/CRO banner (DAND Scale plan, point 11)
VITE_DAND_CONTACT_EMAIL=fondazionedravet@gmail.com

# Official site URL encoded as a QR code on the PDF report (DAND Scale
# plan, point 8). Falls back to window.location.origin if left empty.
VITE_SITE_URL=

# iubenda (managed by Fondazione Dravet). Leave empty until provided:
# /privacy-policy and /cookie-policy then show a "being published" page
# and no cookie banner is loaded.
VITE_IUBENDA_PRIVACY_URL=
VITE_IUBENDA_COOKIE_URL=
# src="..." of the Cookie Solution embed script from the iubenda dashboard
VITE_IUBENDA_CONSENT_SCRIPT_URL=
